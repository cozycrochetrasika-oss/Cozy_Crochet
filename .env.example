# Cozy_Crochets Environment Variables Template
# Copy to .env.local for development. Never commit real credentials to version control.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Payment Provider
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Storefront Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MapLibre / Geolocation Provider
NEXT_PUBLIC_MAPLIBRE_TILE_URL=https://demotiles.maplibre.org/style.json

# Manual UPI & WhatsApp Contact Info
WHATSAPP_NUMBER=+919876543210
CONTACT_EMAIL=hello@cozycrochets.com
INSTAGRAM_URL=https://instagram.com/cozycrochets
UPI_ID=cozycrochets@upi

# Optional MCP Tokens (Names only)
CONTEXT7_API_KEY=
FIGMA_OAUTH_TOKEN=
HIGGSFIELD_OAUTH_TOKEN=